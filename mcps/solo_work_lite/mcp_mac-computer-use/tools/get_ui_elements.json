{
  "name": "get_ui_elements",
  "description": "通过AppleScript获取应用窗口的UI元素树。用于了解界面结构，找到可点击的元素。",
  "arguments": {
    "type": "object",
    "properties": {
      "app_name": {
        "type": "string",
        "description": "应用名称（可选，默认为当前最前应用）"
      },
      "window_index": {
        "type": "integer",
        "description": "窗口序号，默认 1"
      },
      "depth": {
        "type": "integer",
        "description": "遍历深度，默认 2"
      }
    }
  }
}